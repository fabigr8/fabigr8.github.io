---
// A styled aside for blog posts. Usable in .mdx via: <Callout>…</Callout>
interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}
const { type = "note", title } = Astro.props;

const styles = {
  note: "border-accent-400/50 bg-accent-500/[0.06] text-zinc-700 dark:text-zinc-300",
  tip: "border-emerald-400/50 bg-emerald-500/[0.06] text-zinc-700 dark:text-zinc-300",
  warning: "border-amber-400/50 bg-amber-500/[0.07] text-zinc-700 dark:text-zinc-300",
}[type];

const label = title ?? { note: "Note", tip: "Tip", warning: "Warning" }[type];
---

<aside class:list={["not-prose my-6 rounded-xl border px-5 py-4", styles]}>
  <p class="mb-1 text-xs font-semibold uppercase tracking-widest opacity-80">{label}</p>
  <div class="text-sm leading-relaxed [&>*+*]:mt-2">
    <slot />
  </div>
</aside>
