---
import { socials } from "../data/site";

interface Props {
  /** size of the icon buttons in px */
  size?: number;
  class?: string;
}
const { size = 20, class: className = "" } = Astro.props;
---

<ul class:list={["flex flex-wrap items-center gap-1", className]}>
  {
    socials.map((s) => (
      <li>
        <a
          href={s.href}
          target={s.href.startsWith("mailto:") ? undefined : "_blank"}
          rel={s.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-zinc-400 transition-colors hover:text-accent-500 dark:text-zinc-500 dark:hover:text-accent-400"
          aria-label={s.label}
          title={s.label}
        >
          <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={s.icon} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
