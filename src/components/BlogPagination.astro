---
interface Props {
  currentPage: number;
  totalPages: number;
}
const { currentPage, totalPages } = Astro.props;

const hrefFor = (page: number) => (page <= 1 ? "/" : `/blog/page/${page}`);
const prevHref = currentPage > 1 ? hrefFor(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? hrefFor(currentPage + 1) : null;
---

{
  totalPages > 1 && (
    <nav
      aria-label="Blog pagination"
      class="mt-10 flex items-center justify-between border-t border-zinc-100 pt-6 dark:border-zinc-900"
    >
      {prevHref ? (
        <a
          href={prevHref}
          class="text-sm font-medium text-zinc-500 transition-colors hover:text-accent-500 dark:text-zinc-400 dark:hover:text-accent-400"
        >
          ← Newer
        </a>
      ) : (
        <span />
      )}
      <span class="text-xs text-zinc-400 dark:text-zinc-600">
        Page {currentPage} of {totalPages}
      </span>
      {nextHref ? (
        <a
          href={nextHref}
          class="text-sm font-medium text-zinc-500 transition-colors hover:text-accent-500 dark:text-zinc-400 dark:hover:text-accent-400"
        >
          Older →
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
