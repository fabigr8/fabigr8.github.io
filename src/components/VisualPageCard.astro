---
import type { VisualPage } from "../data/visualPages";

interface Props {
  page: VisualPage;
}
const { page } = Astro.props;
const isComingSoon = page.status === "coming-soon";
---

{
  isComingSoon ? (
    <div class="flex h-full flex-col overflow-hidden rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700">
      <div class="flex aspect-video items-center justify-center bg-zinc-50 text-zinc-300 dark:bg-zinc-900/50 dark:text-zinc-700">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4.5" width="18" height="15" rx="1.5" />
          <path d="m3 16 5-5 4 4 3-3 6 6" />
          <circle cx="8" cy="8.5" r="1.5" />
        </svg>
      </div>
      <div class="flex flex-1 flex-col p-4">
        <span class="text-xs font-medium uppercase tracking-widest text-zinc-400 dark:text-zinc-600">
          {page.tag}
        </span>
        <h3 class="mt-1.5 text-base font-semibold text-zinc-400 dark:text-zinc-600">{page.title}</h3>
        <p class="mt-1 flex-1 text-sm text-zinc-400 dark:text-zinc-600">{page.description}</p>
      </div>
    </div>
  ) : (
    <a
      href={page.url}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex h-full flex-col overflow-hidden rounded-xl border border-zinc-200 transition-colors hover:border-accent-400 dark:border-zinc-800 dark:hover:border-accent-500"
    >
      <div class="aspect-video overflow-hidden bg-zinc-100 dark:bg-zinc-900">
        {page.thumbnail && (
          <img
            src={page.thumbnail}
            alt=""
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        )}
      </div>
      <div class="flex flex-1 flex-col p-4">
        <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-500">
          <span class="font-medium uppercase tracking-widest text-accent-500 dark:text-accent-400">
            {page.tag}
          </span>
          {page.date && (
            <>
              <span aria-hidden="true">·</span>
              <span>{page.date}</span>
            </>
          )}
        </div>
        <h3 class="mt-1.5 text-base font-semibold text-zinc-900 transition-colors group-hover:text-accent-500 dark:text-zinc-100 dark:group-hover:text-accent-400">
          {page.title}
        </h3>
        <p class="mt-1 flex-1 text-sm text-zinc-600 dark:text-zinc-400">{page.description}</p>
      </div>
    </a>
  )
}
