---
import type { CollectionEntry } from "astro:content";
import BlogCard from "./BlogCard.astro";
import { groupByYear } from "../lib/blog";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props;
const groups = groupByYear(posts);
---

{
  posts.length === 0 ? (
    <p class="py-12 text-zinc-500 dark:text-zinc-400">No posts yet — check back soon.</p>
  ) : (
    <div class="space-y-10">
      {groups.map(({ year, posts: yearPosts }) => (
        <div>
          <div class="mb-1 flex items-baseline gap-4">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-600">
              {year}
            </h3>
            <div class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800" />
          </div>
          <div class="divide-y divide-zinc-100 dark:divide-zinc-900">
            {yearPosts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </div>
      ))}
    </div>
  )
}
