---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  // Blog is the site root; highlight it on / and on individual post pages.
  { href: "/", label: "Blog", match: (p: string) => p === "/" || p.startsWith("/blog") },
  { href: "/visual", label: "Visual", match: (p: string) => p.startsWith("/visual") },
  { href: "/publications", label: "Publications", match: (p: string) => p.startsWith("/publications") },
  { href: "/cv", label: "CV", match: (p: string) => p.startsWith("/cv") },
];
---

<header class="sticky top-0 z-40 bg-white/70 backdrop-blur-md dark:bg-black/60">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a href="/" class="text-sm font-semibold tracking-tight text-zinc-900 transition-colors hover:text-accent-500 dark:text-zinc-100 dark:hover:text-accent-400">
      {site.name}
    </a>
    <div class="flex items-center gap-5">
      <ul class="flex items-center gap-5">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  "text-xs font-medium uppercase tracking-widest transition-colors",
                  l.match(path)
                    ? "text-zinc-900 dark:text-zinc-100"
                    : "text-zinc-400 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-200",
                ]}
                aria-current={l.match(path) ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
