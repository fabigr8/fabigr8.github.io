---
import type { Publication } from "../data/publications";
import { AUTHOR_NAME } from "../data/publications";

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
---

<article class="border-l-2 border-accent-500/60 pl-6 dark:border-accent-400/50">
  <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-accent-500 dark:text-accent-400">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2l2.9 6.26L21.5 9l-5 4.6L18 21l-6-3.4L6 21l1.5-7.4-5-4.6 6.6-.74L12 2z" />
    </svg>
    Spotlight · {pub.year}
  </div>

  <h3 class="mt-3 font-serif text-2xl font-medium leading-snug text-zinc-900 sm:text-3xl dark:text-zinc-50">
    {pub.title}
  </h3>

  <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
    {
      pub.authors.map((a, i) => (
        <>
          <span class:list={[a === AUTHOR_NAME && "font-semibold text-zinc-900 dark:text-zinc-100"]}>{a}</span>
          {i < pub.authors.length - 1 ? ", " : ""}
        </>
      ))
    }
  </p>

  <p class="mt-1 text-sm italic text-zinc-500 dark:text-zinc-500">{pub.venue}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {
      pub.links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-full border border-zinc-300 px-3.5 py-1 text-xs font-medium text-zinc-700 transition-colors hover:border-accent-400 hover:text-accent-500 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-accent-400 dark:hover:text-accent-400"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</article>
