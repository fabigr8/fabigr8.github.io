---
import type { CollectionEntry } from "astro:content";
import { formatDate, isoDate, readingTime } from "../lib/format";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const mins = readingTime(post.body);
---

<article class="group py-6">
  <a href={`/blog/${post.id}`} class="block">
    <div class="flex items-center gap-3 text-xs text-zinc-500 dark:text-zinc-500">
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{mins} min read</span>
    </div>
    <h3 class="mt-1.5 text-lg font-semibold text-zinc-900 transition-colors group-hover:text-accent-500 dark:text-zinc-100 dark:group-hover:text-accent-400">
      {title}
    </h3>
    <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {description}
    </p>
  </a>
  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded-full border border-zinc-200 px-2.5 py-0.5 text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
