---
import type { Publication } from "../data/publications";
import { AUTHOR_NAME } from "../data/publications";

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
---

<article class="group flex gap-4 py-5">
  <div class="w-12 shrink-0 pt-0.5 text-sm font-semibold tabular-nums text-zinc-400 dark:text-zinc-500">
    {pub.year}
  </div>
  <div class="min-w-0 flex-1">
    <h3 class="font-semibold leading-snug text-zinc-900 dark:text-zinc-100">
      {pub.title}
    </h3>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
      {
        pub.authors.map((a, i) => (
          <>
            <span class:list={[a === AUTHOR_NAME && "font-medium text-zinc-800 dark:text-zinc-200"]}>{a}</span>
            {i < pub.authors.length - 1 ? ", " : ""}
          </>
        ))
      }
    </p>
    <p class="mt-0.5 text-sm italic text-zinc-500 dark:text-zinc-500 whitespace-pre-line">{pub.venue}</p>
    {
      pub.links.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
          {pub.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-medium text-accent-500 underline decoration-dotted underline-offset-2 hover:text-accent-400 dark:text-accent-400"
            >
              {link.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
