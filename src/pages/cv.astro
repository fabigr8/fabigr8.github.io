---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcons from "../components/SocialIcons.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { site } from "../data/site";
import { publications } from "../data/publications";
import {
  bio,
  researchInterests,
  projects,
  education,
  experience,
  service,
} from "../data/cv";

const byYearDesc = [...publications].sort((a, b) => b.year - a.year);
---

<BaseLayout title="CV" description={`Curriculum vitae of ${site.name}`}>
  <!-- Header -->
  <header class="flex flex-col gap-5 sm:flex-row sm:items-center">
    <img
      src={site.avatar}
      alt={`Portrait of ${site.name}`}
      width="96"
      height="96"
      class="h-24 w-24 shrink-0 rounded-full object-cover"
      onerror="this.style.display='none'"
    />
    <div class="flex-1">
      <h1 class="font-serif text-4xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50">{site.name}</h1>
      <p class="text-zinc-600 dark:text-zinc-300">{site.title} · {site.affiliation}</p>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <SocialIcons size={18} />
        <a
          href={site.cvPdf}
          class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 px-3 py-1.5 text-sm font-medium text-zinc-700 transition-colors hover:border-accent-400 hover:text-accent-500 dark:border-zinc-700 dark:text-zinc-200"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"></path>
          </svg>
          Download PDF
        </a>
      </div>
    </div>
  </header>

  <!-- About -->
  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">About</h2>
    <div class="mt-4 space-y-4 text-zinc-700 dark:text-zinc-300">
      {bio.map((p) => <p class="leading-relaxed">{p}</p>)}
    </div>
  </section>

  <!-- Research interests -->
  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Research Interests</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        researchInterests.map((r) => (
          <li class="rounded-full border border-zinc-200 px-3 py-1 text-sm text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
            {r}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Projects -->
  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Funded Projects</h2>
    <div class="mt-4 grid gap-x-8 gap-y-6 sm:grid-cols-2">
      {
        projects.map((p) => (
          <div>
            <h3 class="font-medium text-zinc-900 dark:text-zinc-100">{p.name}</h3>
            <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{p.summary}</p>
            {p.funding && <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">{p.funding}</p>}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Experience -->
  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Experience</h2>
    <div class="mt-4 space-y-6">
      {
        experience.map((item) => (
          <div class="grid gap-1 sm:grid-cols-[9rem_1fr]">
            <div class="text-sm text-zinc-500 dark:text-zinc-500">{item.period}</div>
            <div>
              <div class="font-semibold text-zinc-900 dark:text-zinc-100">{item.title}</div>
              <div class="text-sm text-zinc-600 dark:text-zinc-400">{item.org}</div>
              {item.detail && <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-500">{item.detail}</p>}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Education -->
  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Education</h2>
    <div class="mt-4 space-y-6">
      {
        education.map((item) => (
          <div class="grid gap-1 sm:grid-cols-[9rem_1fr]">
            <div class="text-sm text-zinc-500 dark:text-zinc-500">{item.period}</div>
            <div>
              <div class="font-semibold text-zinc-900 dark:text-zinc-100">{item.title}</div>
              <div class="text-sm text-zinc-600 dark:text-zinc-400">{item.org}</div>
              {item.detail && <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-500">{item.detail}</p>}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Service -->
  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Service</h2>
    <ul class="mt-4 list-inside list-disc space-y-1 text-zinc-700 dark:text-zinc-300">
      {
        service.map((s) => (
          <li>
            {s.url ? (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-zinc-300 underline-offset-2 hover:text-accent-500 hover:decoration-accent-400 dark:decoration-zinc-700"
              >
                {s.label}
              </a>
            ) : (
              s.label
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Publications -->
  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Publications</h2>
    <div class="mt-2 divide-y divide-zinc-100 dark:divide-zinc-900">
      {byYearDesc.map((pub) => <PublicationCard pub={pub} />)}
    </div>
  </section>
</BaseLayout>
