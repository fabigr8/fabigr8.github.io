---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import BlogList from "../components/BlogList.astro";
import BlogPagination from "../components/BlogPagination.astro";
import { site } from "../data/site";
import { getSortedPosts, PAGE_SIZE } from "../lib/blog";

// Start page = the blog, page 1. Older posts paginate to /blog/page/2, etc.
const allPosts = await getSortedPosts();
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const posts = allPosts.slice(0, PAGE_SIZE);
---

<BaseLayout description={site.tagline}>
  <Hero />

  <section aria-labelledby="writing-heading" class="mt-20 sm:mt-28">
    <div class="mb-8 flex items-baseline justify-between">
      <h2 id="writing-heading" class="font-serif text-2xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50">
        Blog
      </h2>
      <a href="/rss.xml" class="text-sm font-medium text-accent-500 underline decoration-dotted underline-offset-2 hover:text-accent-400 dark:text-accent-400">
        RSS
      </a>
    </div>

    <BlogList posts={posts} />
    <BlogPagination currentPage={1} totalPages={totalPages} />
  </section>
</BaseLayout>