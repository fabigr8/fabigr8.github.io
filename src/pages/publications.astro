---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationSpotlight from "../components/PublicationSpotlight.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { publications } from "../data/publications";

const byYearDesc = [...publications].sort((a, b) => b.year - a.year);
const featured = byYearDesc.find((p) => p.featured);
const rest = byYearDesc.filter((p) => p !== featured);
---

<BaseLayout title="Publications" description="Peer-reviewed publications by Fabian Gwinner.">
  <header class="mb-8">
    <div class="flex items-baseline justify-between">
      <h1 class="font-serif text-4xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50">
        Publications
      </h1>
      <span class="text-sm text-zinc-500 dark:text-zinc-500">{publications.length} papers</span>
    </div>
    <p class="mt-2 max-w-2xl text-zinc-600 dark:text-zinc-300">
      My own peer-reviewed research on explainable AI, process mining, and decision support, spanning
      anomaly detection, industrial applications, and information systems engineering.
    </p>
  </header>

  {featured && <PublicationSpotlight pub={featured} />}

  <div class="mt-8 divide-y divide-zinc-100 dark:divide-zinc-900">
    {rest.map((pub) => <PublicationCard pub={pub} />)}
  </div>
</BaseLayout>
