---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/BlogList.astro";
import BlogPagination from "../../../components/BlogPagination.astro";
import { site } from "../../../data/site";
import { getSortedPosts, PAGE_SIZE } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));

  // Page 1 lives at "/"; this route only serves page 2 and up.
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
        page,
        totalPages,
      },
    };
  });
}

const { posts, page, totalPages } = Astro.props;
---

<BaseLayout title={`Blog — page ${page}`} description={site.tagline}>
  <div class="mb-8 flex items-baseline justify-between">
    <h2 class="font-serif text-2xl font-medium tracking-tight text-zinc-900 dark:text-zinc-50">
      Blog
    </h2>
    <a
      href="/rss.xml"
      class="text-sm font-medium text-accent-500 underline decoration-dotted underline-offset-2 hover:text-accent-400 dark:text-accent-400"
    >
      RSS
    </a>
  </div>

  <BlogList posts={posts} />
  <BlogPagination currentPage={page} totalPages={totalPages} />
</BaseLayout>
